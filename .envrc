# ecosystem — toolchain + caches locked INSIDE the SSD project dir.
# direnv applies/reverts these on cd so $HOME / the internal disk stay clean.
export XDG_CACHE_HOME="$PWD/.cache"
# Python (uv): interpreter + cache pinned local.
# No `layout uv` here — the uv project lives in apps/backend, so its venv is
# apps/backend/.venv. A root venv would only shadow it and warn on every command.
export UV_CACHE_DIR="$PWD/.uv_cache"
[[ -n "$UV_PYTHON_INSTALL_DIR" ]] || export UV_PYTHON_INSTALL_DIR="$PWD/.uv_python"
# Node / JS: caches pinned local
export npm_config_cache="$PWD/.npm_cache"
export PNPM_HOME="$PWD/.pnpm_home"
export BUN_INSTALL="$PWD/.bun"
export PATH="$BUN_INSTALL/bin:$PNPM_HOME:$PATH"
