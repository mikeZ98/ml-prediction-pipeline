# ── Core API keys ──────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# ── Encryption / secrets ───────────────────────────────────────
APP_SECRET_KEY=
JWT_SECRET=
ENCRYPTION_KEY=
# ── Homelab infrastructure endpoints ───────────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app
REDIS_URL=redis://127.0.0.1:6379/0
OLLAMA_HOST=http://lab:11434
OPENAI_API_BASE=http://lab:4000
QDRANT_URL=http://lab:6333
N8N_WEBHOOK_URL=http://lab:5678
# ── App ────────────────────────────────────────────────────────
APP_ENV=local
LOG_LEVEL=info
# ── mlpp serving / tracking (read by docker-compose.yml) ───────
# Session the API serves (any OUTPUTS/<run> directory).
MLPP_SESSION=./OUTPUTS/example
MLPP_API_PORT=8100
MLPP_MAX_BATCH_ROWS=1000
MLPP_MAX_CONCURRENCY=4
MLPP_INTRA_OP_THREADS=2
MLFLOW_PORT=5050
# Point mlpp-train at the compose MLflow server (unset: local SQLite under mlruns/).
MLFLOW_TRACKING_URI=http://localhost:5050
